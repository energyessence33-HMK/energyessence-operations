# Kingdom Executor Studio - Production Environment Configuration
# Last Updated: July 31, 2026
# Status: Production Ready

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

NODE_ENV=production
APP_NAME=Kingdom Executor Studio
APP_VERSION=8.0.0
APP_ENVIRONMENT=production
DEBUG=false

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

SERVER_PORT=3000
SERVER_HOST=0.0.0.0
API_BASE_URL=https://energyessence2.store/api
WEB_BASE_URL=https://energyessence2.store

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

DATABASE_URL=postgresql://user:password@db.supabase.co:5432/kingdom_executor
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=true
DATABASE_TIMEOUT=30000

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

JWT_SECRET=your-secure-jwt-secret-here-min-32-chars
JWT_EXPIRATION=7d
REFRESH_TOKEN_EXPIRATION=30d
SESSION_TIMEOUT=3600000

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret

# ============================================================================
# SHOPIFY INTEGRATION
# ============================================================================

SHOPIFY_STORE_URL=energyessence1.myshopify.com
SHOPIFY_ACCESS_TOKEN=your-shopify-access-token
SHOPIFY_API_VERSION=2024-01
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret

# ============================================================================
# STRIPE INTEGRATION
# ============================================================================

STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_API_VERSION=2024-04-10

# ============================================================================
# KLAVIYO INTEGRATION
# ============================================================================

KLAVIYO_API_KEY=your-klaviyo-api-key
KLAVIYO_API_VERSION=2024-02-15
KLAVIYO_ACCOUNT_ID=your-klaviyo-account-id

# ============================================================================
# PRINTIFY INTEGRATION
# ============================================================================

PRINTIFY_API_KEY=your-printify-api-key
PRINTIFY_SHOP_ID=your-printify-shop-id

# ============================================================================
# TWILIO INTEGRATION
# ============================================================================

TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# SENDGRID INTEGRATION
# ============================================================================

SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@energyessence2.store
SENDGRID_FROM_NAME=Kingdom Executor Studio

# ============================================================================
# OPENAI INTEGRATION
# ============================================================================

OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORG_ID=your-openai-org-id
OPENAI_MODEL=gpt-4-turbo

# ============================================================================
# KLING AI INTEGRATION
# ============================================================================

KLING_ACCESS_KEY=your-kling-access-key
KLING_SECRET_KEY=your-kling-secret-key

# ============================================================================
# SUPABASE INTEGRATION
# ============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

STORAGE_TYPE=s3
AWS_S3_BUCKET=kingdom-executor-storage
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY_ID=your-aws-access-key
AWS_S3_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_ENDPOINT=https://s3.amazonaws.com

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================

ANALYTICS_ENABLED=true
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

LOG_LEVEL=info
LOG_FORMAT=json
LOG_DESTINATION=stdout

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

CACHE_TYPE=redis
REDIS_URL=redis://cache.redis.cloud:6379
REDIS_PASSWORD=your-redis-password
CACHE_TTL=3600

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

EMAIL_SERVICE=sendgrid
EMAIL_FROM=noreply@energyessence2.store
EMAIL_SUPPORT=support@energyessence2.store
EMAIL_SALES=sales@energyessence2.store

# ============================================================================
# NOTIFICATION CONFIGURATION
# ============================================================================

NOTIFICATIONS_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=true
SMS_NOTIFICATIONS_ENABLED=true
EMAIL_NOTIFICATIONS_ENABLED=true

# ============================================================================
# FEATURE FLAGS
# ============================================================================

FEATURE_LOYALTY_PROGRAM=true
FEATURE_GAMIFICATION=true
FEATURE_VOICE_COMMANDS=true
FEATURE_CALENDAR_SYNC=true
FEATURE_REAL_TIME_COLLABORATION=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_AI_COACHING=true
FEATURE_TEAM_MANAGEMENT=true

# ============================================================================
# PERFORMANCE CONFIGURATION
# ============================================================================

ENABLE_COMPRESSION=true
ENABLE_CACHING=true
ENABLE_CDN=true
ENABLE_LAZY_LOADING=true
ENABLE_CODE_SPLITTING=true

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

ENABLE_HTTPS=true
ENABLE_CORS=true
ENABLE_RATE_LIMITING=true
ENABLE_CSRF_PROTECTION=true
ENABLE_HELMET=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================

DEPLOYMENT_ENVIRONMENT=production
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_PLATFORM=vercel
AUTO_SCALING_ENABLED=true
MIN_INSTANCES=1
MAX_INSTANCES=10

# ============================================================================
# MONITORING & ALERTS
# ============================================================================

UPTIME_MONITORING_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true
ERROR_TRACKING_ENABLED=true
ALERT_EMAIL=alerts@energyessence2.store
ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# MAINTENANCE MODE
# ============================================================================

MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System maintenance in progress. Please try again later.

# ============================================================================
# NOTES
# ============================================================================

# This file contains production environment variables for Kingdom Executor Studio.
# All sensitive values should be replaced with actual credentials.
# Never commit this file to version control.
# Use GitHub Secrets for CI/CD pipelines.
# Rotate secrets regularly for security.
# Monitor all integrations for errors and performance issues.
